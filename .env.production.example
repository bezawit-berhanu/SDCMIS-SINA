# =============================================================================
# SDCMIS-SINA Production Environment Configuration (.env.production)
# =============================================================================

# Server Environment
NODE_ENV=production
PORT=5000
API_BASE_URL=https://api.sdcmis-sina.com

# Production Database (MariaDB / TiDB Cloud with SSL/TLS)
DATABASE_URL="mysql://sdcmis_user:StrongProdPassword2026!@db.sdcmis-sina.internal:3306/sdcmis_sina?sslaccept=strict&connection_limit=25&pool_timeout=10"

# JWT Authentication Secrets (Must be at least 32 cryptographically secure characters)
JWT_SECRET="d58f3a9e72b4c19a84f0e63d81b952a7c4f108e923ab74c5d8e12f07b469ca31"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="a7c4f108e923ab74c5d8e12f07b469ca31d58f3a9e72b4c19a84f0e63d81b952"
REFRESH_TOKEN_EXPIRES_IN="7d"

# CORS Allowed Origins (Comma-separated HTTPS origins)
CORS_ORIGIN="https://sdcmis-sina.com,https://app.sdcmis-sina.com"

# Real-Time Gateway & WebSocket Settings
WS_PATH="/ws/queue"
WS_HEARTBEAT_INTERVAL_MS=30000
WS_CLIENT_TIMEOUT_MS=60000

# Production Logging
LOG_LEVEL="INFO"
LOG_FORMAT="json"

# Security Headers & Cookie Flags
COOKIE_SECURE=true
COOKIE_SAME_SITE="Strict"
COOKIE_DOMAIN=".sdcmis-sina.com"

